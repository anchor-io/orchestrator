{
  "name": "@anchorsoft/orquesta",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "TMPDIR=/tmp vitest run --passWithNoTests",
    "test:unit:watch": "TMPDIR=/tmp vitest",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "quality": "pnpm run format:check && pnpm run check && pnpm run lint && pnpm run test",
    "docker:up": "docker compose -f compose.yml up -d",
    "docker:down": "docker compose -f compose.yml down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.2.9",
    "@inlang/paraglide-js": "2.20.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-node": "next",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.2",
    "@valibot/to-json-schema": "1.7.1",
    "@vitest/browser-playwright": "4.1.9",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "jsrepo": "3.8.0",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "svelte-render-scan": "1.1.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vitest": "4.1.9",
    "vitest-browser-svelte": "2.2.0"
  },
  "dependencies": {
    "@anchorsoft/orquesta-core": "workspace:*",
    "@anchorsoft/orquesta-rpc": "workspace:*",
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "12.11.1",
    "bits-ui": "^2.18.1",
    "clsx": "2.1.1",
    "jsonc-parser": "3.3.1",
    "phosphor-svelte": "^3.1.0",
    "runed": "0.37.1",
    "svelte-inspect-value": "0.11.3",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "valibot": "1.4.2"
  }
}
